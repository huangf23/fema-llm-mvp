# OpenAI-compatible provider config.
# Copy this file to .env, fill keys on the experiment PC, and choose profiles.

# Comma-separated profiles to run with run_profiles.py.
EXPERIMENT_PROFILES=deepseek_v4_flash

# Generic single-model fallback for run_llm.py without --profile.
API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# DeepSeek V4 Flash.
# Official OpenAI-format base URL: https://api.deepseek.com
DEEPSEEK_V4_FLASH_API_KEY=
DEEPSEEK_V4_FLASH_BASE_URL=https://api.deepseek.com
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_FLASH_THINKING=disabled

# OpenAI-compatible profile templates. Fill only the providers you will use.
OPENAI_MINI_API_KEY=
OPENAI_MINI_BASE_URL=
OPENAI_MINI_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

GEMINI_OPENAI_API_KEY=
GEMINI_OPENAI_BASE_URL=
GEMINI_OPENAI_MODEL=
